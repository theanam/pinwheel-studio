{
  "name": "Pinwheel Studio",
  "short_name": "Pinwheel",
  "description": "An open-source desktop-publishing studio that runs entirely in the browser. No account, no server, no uploads.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#F4F2EE",
  "theme_color": "#F4F2EE",
  "orientation": "any",
  "categories": ["graphics", "productivity"],
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.pinwheel+zip": [".pinwheel"] },
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
