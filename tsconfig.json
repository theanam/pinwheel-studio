{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    /* The four modules are still JavaScript (spec §3 calls the prototype plain ES
       modules). They are type-checked as they move to .ts, one at a time; the model
       contract in src/model.d.ts is checked today. */
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src", "scripts", "vite.config.js"]
}
