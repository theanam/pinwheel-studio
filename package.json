{
  "name": "pinwheel-studio",
  "version": "1.0.0",
  "description": "An open-source desktop-publishing studio that runs entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:visual": "node scripts/visual-baselines.mjs",
    "test:browser": "node tests/browser/smoke.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build:offline": "node scripts/vendor.mjs --model && VITE_VENDOR=1 vite build",
    "icons": "node scripts/make-icons.mjs",
    "test": "node tests/suggest.test.mjs && node tests/brand.test.mjs && node scripts/visual-baselines.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "node-html-parser": "^7.0.1"
  }
}
